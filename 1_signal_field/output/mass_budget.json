  "priors": {
   "lwl_over_esloria": {
    "dist": "uniform",
    "params": [
     0.815,
     0.95
    ],
    "basis": "esloria is the main-deck length from stem to sternpost (Martin p. 409). The waterline lies between that and the keel, which Martin takes as 53/65 of the esloria for Lavia, after Veitia Linage's 700-ton galleon (App. 1 n. 5, p. 506)"
   },
   "bwl_over_manga": {
    "dist": "uniform",
    "params": [
     1.0,
     1.08
    ],
    "basis": "manga is the beam taken internally at midships (p. 409); add frames and planking on both sides, less any narrowing at the waterline"
   },
   "normal_draught_over_puntal": {
    "dist": "uniform",
    "params": [
     0.65,
     0.95
    ],
    "basis": "the draught fully laden. Puntal runs from under the main deck to the bottom of the hold (p. 409). Martin's draughts: Valencera about 4 m normal (p. 130), Girona about 4.5 m (p. 174), San Juan de Sicilia about 20 ft from her 28 ft rudder (p. 217). For Lavia's 6.18 m puntal this range gives 4.0-5.9 m"
   },
   "block_coeff": {
    "dist": "uniform",
    "params": [
     0.45,
     0.62
    ],
    "basis": "full-bodied Mediterranean merchant hulls; no lines survive. The rating formula's own (M/2) x 0.97 treats the hold as 0.485 of its box: a hint, not evidence"
   },
   "lightship_frac": {
    "dist": "uniform",
    "params": [
     0.35,
     0.55
    ],
    "basis": "hull, rig, ground tackle and fittings as a share of the fully laden displacement. No surviving figure for these hulls: the leading open question (see drivers)"
   },
   "rig_share": {
    "dist": "uniform",
    "params": [
     0.08,
     0.15
    ],
    "basis": "masts, yards, sails and cordage as a share of the lightship"
   },
   "metal_share": {
    "dist": "uniform",
    "params": [
     0.04,
     0.1
    ],
    "basis": "iron in the lightship: bolts and fastenings (these Levant hulls were iron-fastened, Martin p. 217), anchors, chain-plates, galley ironwork"
   },
   "ballast_scale": {
    "dist": "uniform",
    "params": [
     0.6,
     1.5
    ],
    "basis": "multiplies the Rosa's 90 t (p. 150) at 945 toneladas (p. 139), scaled by machos as a volume proxy. Wide: the mound is what survived, and ballasting varied"
   },
   "cargo_u": {
    "dist": "uniform",
    "params": [
     0.0,
     1.0
    ],
    "basis": "position in each ship's cargo range (CARGO_T), shared: siege train and army stores beyond the ship's own munitions"
   },
   "liquid_days": {
    "dist": "uniform",
    "params": [
     0.0,
     15.0
    ],
    "basis": "days of wine and water left. Six months' rations at Lisbon, replenished at Corunna, 50% wastage allowed; it was the unintended voyage home without water that caused the privations (p. 349). The ships had put in to the Irish coast"
   },
   "solid_days": {
